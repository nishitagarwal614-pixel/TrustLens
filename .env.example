# TrustLens AI Environment Configuration

# LLM Provider Configuration (Optional, recommended 'gemini')
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here

# Used for Vision (Image Extraction) and optional LLM reasoning
GEMINI_API_KEY=your_gemini_api_key_here

# Database Connection (Defaults to SQLite in local project root)
DATABASE_URL=sqlite:///./trustlens.db

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Demo Mode Enabled (Can be set to false now)
DEMO_MODE=false
